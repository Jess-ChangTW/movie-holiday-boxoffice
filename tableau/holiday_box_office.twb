    <worksheet name='Release Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>When do studios release horror and romance films?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>Horror’s share of releases jumps to 30-34% in the five weeks before Halloween, vs a 20% yearly average, then drops to the year’s lowest right after.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
