              <flipboard active-id='3' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Studios cluster horror before Halloween' captured-sheet='1. Scheduling' id='1' />
                  <story-point caption='Matched genres earn more in the window, because everything else slumps' captured-sheet='2. Box Office' id='2'>
