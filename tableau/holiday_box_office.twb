            <column-instance column='[Week of Year]' derivation='None' name='[none:Week of Year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Title]' derivation='Count' name='[pcto:cnt:Title:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.19xqcwa0gcu6m818ymsxi07evd7f].[Week of Year]' ordering-type='Field' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.19xqcwa0gcu6m818ymsxi07evd7f].[none:Genre:nk]'>
            <groupfilter count='12' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='COUNT([Title])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Genre:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
